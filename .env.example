# Sao chép file này thành .env rồi điền giá trị thật.
# Không commit file .env lên GitHub.

# API key Gemini — lấy tại https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key-here

# Giữ = 0 nếu dùng Google AI Studio (không dùng Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=0

# Model routing cho các tác vụ gọi LLM trực tiếp trong lab
# gemini = dùng Google Gemini
# openai = dùng OpenAI hoặc OpenAI-compatible endpoint
MODEL_PROVIDER=gemini

# Gemini direct model (dùng cho judge/attack generator nếu MODEL_PROVIDER=gemini)
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI direct model config
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
