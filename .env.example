# Sao chép file này thành .env rồi điền giá trị thật.
# Không commit file .env lên GitHub.

# --- Chọn nhà cung cấp LLM (một trong hai) ---
LLM_PROVIDER=gemini
# LLM_PROVIDER=openai

# --- Gemini ---
# Key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key-here
GOOGLE_GENAI_USE_VERTEXAI=0
# Mặc định (còn phát hành):
GEMINI_MODEL=gemini-3.5-flash
# Khó hơn (điểm cộng)
# GEMINI_MODEL=gemini-3.8-flash

# --- OpenAI ---
# Key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# Mặc định:
# OPENAI_MODEL=gpt-4o-mini
# Khó hơn (điểm cộng):
# OPENAI_MODEL=gpt-5.6-luna
# (Khó hơn nữa nếu muốn: gpt-5.6-sol)

# STUDENT_ID=SE12345
