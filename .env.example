# Sao chép file này thành .env rồi điền giá trị thật.
# Không commit file .env lên GitHub.

# OpenAI API key — ưu tiên provider OpenAI
OPENAI_API_KEY=your-openai-api-key-here
AI_PROVIDER=openai

# Optional OpenRouter OpenAI-compatible provider
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=openrouter/free

# Gemini fallback — lấy tại https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key-here

# Giữ = 0 nếu dùng Google AI Studio (không dùng Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=0
